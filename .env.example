# Copy this file to .env and fill in your values. NEVER commit .env to version control.
# Real credentials must remain strictly local and private.

# =============================================================================
# Google Gemini AI (Required for API backend and Website Builder)
# =============================================================================
# Get a key from https://aistudio.google.com/apikey (server-side only)
GEMINI_API_KEY=your-gemini-api-key-here

# "auto" picks the fastest/best available model from your account's model list.
# Or set an explicit model id, e.g. gemini-3.5-flash / gemini-3.5-flash-lite / gemini-2.5-flash
# AI provider: gemini (default) or glm (Zhipu / Z.ai GLM models, https://z.ai). With glm every AI call (chat,
# Android apps, websites) uses GLM_API_KEY and the GLM models below; the GEMINI_* settings are ignored.
GENESIS_AI_PROVIDER=gemini
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
# Asked when the main model stays busy. Only glm-4.7-flash is free; glm-4.5-flash needs a paid balance.
GLM_FALLBACK_MODELS=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4   (mainland China keys: https://open.bigmodel.cn/api/paas/v4)
GEMINI_MODEL=auto

# AI provider for conversation and code generation:
# "api" (Gemini API, needs GEMINI_API_KEY; recommended) or
# "antigravity" (Antigravity desktop app agentapi bridge)
GENESIS_AI_BACKEND=api
GENESIS_ANTIGRAVITY_MODEL=app

# =============================================================================
# Conversational Intelligence & Natural Language Generation (NLG)
# =============================================================================
# Plain-language conversation through ChatBrain (on | off)
GENESIS_CHAT_BRAIN=on
GENESIS_CHAT_TIMEOUT_SECONDS=25
# Lightweight model for conversational replies (~1-2s response time)
GENESIS_CHAT_MODEL=gemini-3.5-flash-lite

# Natural Language Generation for deterministic command outcomes (on | off)
GENESIS_NLG=on
GENESIS_NLG_TIMEOUT_SECONDS=12
GENESIS_NLG_MODEL=gemini-3.5-flash-lite

# =============================================================================
# Voice Notes & Audio Transcription (Whisper)
# =============================================================================
# Transcribes incoming audio messages locally with faster-whisper (on | off)
GENESIS_VOICE=on
# Model options: tiny | base | small | medium (or .en variants)
GENESIS_VOICE_MODEL=base
# Language code, e.g. "en" or leave empty for auto-detection
GENESIS_VOICE_LANGUAGE=

# =============================================================================
# Server & Dashboard Configuration
# =============================================================================
# Dashboard bind host and port (Keep 127.0.0.1 for local security)
GENESIS_HOST=127.0.0.1
GENESIS_PORT=8765

# Public https origin that forwards to this machine (e.g. Cloudflare tunnel or reverse proxy)
# Used for webhook verification and generating secure download links
PUBLIC_BASE_URL=https://your-public-subdomain.example.com

# =============================================================================
# Meta WhatsApp Cloud API (Graph API)
# =============================================================================
# WhatsApp provider: meta (recommended) | twilio | off
GENESIS_WHATSAPP_PROVIDER=meta

# Permanent System User token or 24-hr token from Meta App Dashboard
META_ACCESS_TOKEN=your-meta-system-user-access-token

# Phone Number ID from WhatsApp > API Setup (numeric ID, not phone number)
META_PHONE_NUMBER_ID=your-meta-phone-number-id

# WhatsApp Business Account ID (WABA) from WhatsApp > API Setup
META_BUSINESS_ACCOUNT_ID=your-meta-business-account-id

# Webhook verification token you choose for Meta webhook setup (GET challenge)
META_VERIFY_TOKEN=your-random-webhook-verify-token

# App Secret from App Settings > Basic (used for X-Hub-Signature-256 HMAC validation)
META_APP_SECRET=your-meta-app-secret

# Graph API version (default: v21.0)
META_GRAPH_API_VERSION=v21.0

# =============================================================================
# Twilio SMS / WhatsApp (Alternative messaging provider)
# =============================================================================
GENESIS_SMS_PROVIDER=off
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_CHANNEL=sms
TWILIO_REGION=
TWILIO_EDGE=

# =============================================================================
# Access Control, Authorization & Quotas
# =============================================================================
# Access mode: closed (owners only) | link (owners + LINK <code>) | open (anyone)
#   | account (anyone with an account from PUBLIC_BASE_URL/start; they text LINK <code> from the dashboard)
GENESIS_SMS_SIGNUP=link
# Google sign-in for accounts (optional). Redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Per-account limits: storage for hosted sites (MB), live projects, and days a deleted project can be restored.
GENESIS_USER_STORAGE_MB=50
GENESIS_MAX_PROJECTS=25
GENESIS_TRASH_DAYS=30
# Referrals: users text INVITE for a code; friends text JOIN <code>. Each join gives the inviter extra daily builds.
GENESIS_SMS_REFERRALS=on
GENESIS_SMS_REFERRAL_BONUS=2
GENESIS_SMS_REFERRAL_MAX=20

# Owner phone numbers in E.164 format, comma-separated (e.g. +14155552671,+919876543210)
# Owners bypass link codes and have administrative privileges
GENESIS_SMS_OWNER_NUMBERS=

# Default country code when phone number is missing a prefix
GENESIS_SMS_DEFAULT_COUNTRY_CODE=+1

# Worker mode: embedded (runs inside `genesis serve`) | external (run `python -m genesis sms-worker`)
GENESIS_SMS_WORKER=embedded

# Daily build limits and rate limits
GENESIS_SMS_DAILY_BUILDS=20
GENESIS_SMS_GUEST_DAILY_BUILDS=3
GENESIS_SMS_INBOUND_PER_HOUR=30
GENESIS_SMS_MAX_QUEUED=20
GENESIS_SMS_JOB_MAX_ATTEMPTS=3
GENESIS_SMS_PROGRESS=major
GENESIS_SMS_PROGRESS_MIN_INTERVAL_SECONDS=60
GENESIS_SMS_LINK_TTL_HOURS=72

# =============================================================================
# Android App Builder Toolchain & Limits
# =============================================================================
# Paths auto-detected if left empty
JAVA_HOME=
ANDROID_HOME=

# Build timeouts and retry limits
GENESIS_BUILD_TIMEOUT_SECONDS=900
GENESIS_MAX_REPAIR_ATTEMPTS=2
GENESIS_MAX_CONCURRENT_BUILDS=1
GENESIS_MAX_QUEUED_BUILDS=5

# =============================================================================
# Website Builder (Optional)
# =============================================================================
GENESIS_WEBSITE_BUILDER=on
GENESIS_WEBSITE_ENGINE_DIR=
GENESIS_NODE_BIN=
GENESIS_WEBSITE_VARIANTS=1
GENESIS_WEBSITE_PAGES=3
GENESIS_WEBSITE_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
GENESIS_WEBSITE_TIMEOUT_SECONDS=1200

# Publishing: off | netlify | weave
GENESIS_WEBSITE_DEPLOY=off
# If using weave hosting (https://<name>.<GENESIS_SITES_DOMAIN>/):
GENESIS_SITES_DOMAIN=
# If using netlify:
NETLIFY_AUTH_TOKEN=
